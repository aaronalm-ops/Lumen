<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.6.0: sermon notes run as a short data sync while the recording uploads and Gemini writes.
         Notifications are asked for only when the owner first taps Write notes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 1b: Drive streaming and downloads check for a validated, unmetered network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Whole-phone scan through MediaStore. Requested at runtime only when the user taps
         "Scan whole phone" or "Scan my phone"; never on launch. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- 0.5.0: Lumen opens YouTube Music by package and checks that it is installed. -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:name=".LumenApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumen">

        <!-- 0.5.0: Chromecast. The Cast framework reads its options (the Default Media Receiver)
             from this provider; Media3's CastPlayer creates the CastContext from it. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.lumen.player.cast.LumenCastOptionsProvider" />

        <!-- Android Auto: lists the app as a media source. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Theme.Lumen.Splash is the Android 12 splash (black, the arc); installSplashScreen()
             in onCreate hands over to Theme.Lumen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lumen.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for audio and video files from Files, WhatsApp, Drive, the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <!-- 0.5.0: "Share" from YouTube Music: a song or playlist link as text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 0.6.0: the YouTube Music notification listener (0.5.0) is gone. Play Protect blocks
             sideloaded apps that ask for notification access, so 0.5.0 and 0.5.1 could not install. -->

        <service
            android:name=".notes.NotesService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Home screen widget (Glance). -->
        <receiver
            android:name=".widget.LumenWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lumen_widget_info" />
        </receiver>

        <!-- Widget buttons: forwards play, pause, back and forward to the session. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
