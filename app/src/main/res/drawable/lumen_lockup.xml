<?xml version="1.0" encoding="utf-8"?>
<!-- The LUMEN mark: a tilted elliptical light trail, cool silver at the lower left, warm white
     over the top, amber at the core on the right, with a radial glow around the core. The
     wordmark is Compose text (Manrope 500, 0.18 em tracking) in LumenLockup(); a vector cannot
     carry font outlines. Gradients use aapt:attr (VectorDrawable gradients, API 24 and later).
     Viewport 40 by 32; the trail is sized for 32 dp high use. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="40dp"
    android:height="32dp"
    android:viewportWidth="40"
    android:viewportHeight="32">

    <!-- Glow around the core. -->
    <path android:pathData="M31.04,10.17 m-8,0 a8,8 0 1 1 16,0 a8,8 0 1 1 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="31.04"
                android:centerY="10.17"
                android:gradientRadius="8">
                <item android:offset="0" android:color="#80E8862B" />
                <item android:offset="0.45" android:color="#2EE8862B" />
                <item android:offset="1" android:color="#00E8862B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Faint return of the trail under the ellipse, from the core down and to the left. -->
    <path
        android:pathData="M31.04,10.17 L31.26,10.82 L31.39,11.52 L31.42,12.25 L31.35,13.01 L31.18,13.80 L30.92,14.60 L30.56,15.43 L30.11,16.25 L29.57,17.09 L28.94,17.91 L28.24,18.73 L27.46,19.53 L26.61,20.31 L25.69,21.06 L24.72,21.77 L23.70,22.45 L22.64,23.08 L21.55,23.67 L20.43,24.20 L19.29,24.68 L18.14,25.10 L16.99,25.45"
        android:strokeWidth="0.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="10"
                android:endX="17"
                android:endY="25.5">
                <item android:offset="0" android:color="#B3E8862B" />
                <item android:offset="0.5" android:color="#40FFF4E6" />
                <item android:offset="1" android:color="#00C7CBD1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The main trail: lower left over the top to the core. -->
    <path
        android:pathData="M6.46,24.70 L5.91,24.23 L5.46,23.70 L5.09,23.11 L4.83,22.48 L4.66,21.80 L4.58,21.08 L4.61,20.33 L4.73,19.55 L4.96,18.75 L5.28,17.93 L5.69,17.10 L6.19,16.27 L6.79,15.43 L7.46,14.61 L8.21,13.80 L9.04,13.01 L9.93,12.25 L10.88,11.51 L11.88,10.82 L12.93,10.16 L14.01,9.56 L15.13,9.00 L16.27,8.50 L17.41,8.06 L18.57,7.68 L19.72,7.36 L20.85,7.12 L21.97,6.94 L23.05,6.83 L24.10,6.80 L25.11,6.83 L26.06,6.94 L26.95,7.12 L27.77,7.37 L28.53,7.68 L29.20,8.06 L29.80,8.50 L30.30,9.01 L30.72,9.56 L31.04,10.17"
        android:strokeWidth="1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="5"
                android:startY="24"
                android:endX="31"
                android:endY="10">
                <item android:offset="0" android:color="#00C7CBD1" />
                <item android:offset="0.12" android:color="#C7CBD1" />
                <item android:offset="0.55" android:color="#FFF4E6" />
                <item android:offset="0.85" android:color="#FFD9A8" />
                <item android:offset="1" android:color="#E8862B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The brighter, thicker stretch into the core. -->
    <path
        android:pathData="M21.31,7.04 L22.31,6.90 L23.28,6.82 L24.21,6.80 L25.11,6.83 L25.97,6.93 L26.78,7.08 L27.54,7.29 L28.24,7.55 L28.88,7.87 L29.45,8.23 L29.96,8.65 L30.39,9.11 L30.75,9.62 L31.04,10.17"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="21"
                android:startY="7"
                android:endX="31"
                android:endY="10">
                <item android:offset="0" android:color="#00FFF4E6" />
                <item android:offset="0.5" android:color="#CCFFF4E6" />
                <item android:offset="1" android:color="#E8862B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The core itself. -->
    <path
        android:pathData="M31.04,10.17 m-1.3,0 a1.3,1.3 0 1 1 2.6,0 a1.3,1.3 0 1 1 -2.6,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="31.04"
                android:centerY="10.17"
                android:gradientRadius="1.3">
                <item android:offset="0" android:color="#FFF4E6" />
                <item android:offset="1" android:color="#E8862B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
