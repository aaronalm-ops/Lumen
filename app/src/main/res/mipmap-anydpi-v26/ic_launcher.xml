<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <!-- The foreground goes through a layer-list so a raster glow can replace the vector without
         touching this file; see drawable/ic_launcher_fg.xml. -->
    <foreground android:drawable="@drawable/ic_launcher_fg" />
    <!-- Themed icons need the flat vector; never point this at the raster. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
