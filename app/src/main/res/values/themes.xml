<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose Material3 supplies the real colour scheme. This platform theme only removes the
         action bar and keeps the window on the light ground during start-up, since Home is light.
         Now Playing paints true black itself; the status bar icon colour is switched in Compose. -->
    <style name="Theme.Lumen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/base_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorPrimary">@color/amber_light</item>
        <item name="android:colorAccent">@color/amber_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Phase 1b: the system splash (androidx.core:core-splashscreen). Black window, the
         launcher arc as the icon, no animation; MainActivity calls installSplashScreen() and
         then switches to Theme.Lumen through postSplashScreenTheme. -->
    <style name="Theme.Lumen.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Lumen</item>
    </style>

    <!-- The Drive picker WebView: true black behind the page. -->
    <style name="Theme.Lumen.Picker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>
