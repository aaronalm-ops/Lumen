<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only in Phase 0. Compose Material3 supplies the real colour scheme; this platform
         theme only removes the action bar and keeps the window true black during start-up. -->
    <style name="Theme.Lumen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorPrimary">@color/amber</item>
        <item name="android:colorAccent">@color/amber</item>
    </style>
</resources>
