<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts. targetPackage must be the literal application id, so these apply
     to the release build (com.aaronalmeida.lumen); the debug build's ".debug" suffix does not see them. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="resume"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_resume"
        android:shortcutShortLabel="@string/shortcut_resume_short"
        android:shortcutLongLabel="@string/shortcut_resume_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aaronalmeida.lumen"
            android:targetClass="app.lumen.player.MainActivity">
            <extra android:name="app.lumen.player.shortcut" android:value="resume" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="worship"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_worship"
        android:shortcutShortLabel="@string/shortcut_worship_short"
        android:shortcutLongLabel="@string/shortcut_worship_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aaronalmeida.lumen"
            android:targetClass="app.lumen.player.MainActivity">
            <extra android:name="app.lumen.player.shortcut" android:value="worship" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="kids"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_kids"
        android:shortcutShortLabel="@string/shortcut_kids_short"
        android:shortcutLongLabel="@string/shortcut_kids_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aaronalmeida.lumen"
            android:targetClass="app.lumen.player.MainActivity">
            <extra android:name="app.lumen.player.shortcut" android:value="kids" />
        </intent>
    </shortcut>
</shortcuts>
